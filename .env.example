# Copy to .env (git ignores it) and set your own value:
#   cp .env.example .env
# Used by docker compose and by the backend's `local` profile. Never reuse it outside your laptop.

# Password of the local PostgreSQL. It is set when the database volume is first created;
# to change it later, run `docker compose down -v` (deletes local data) and start again.
DB_PASSWORD=change-me
