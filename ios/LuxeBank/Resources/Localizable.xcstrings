    },
    "info.help.fraud.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Freeze the card from its screen, then contact your relationship manager or the call centre straight away."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ระงับบัตรชั่วคราวจากหน้าบัตร แล้วติดต่อผู้ดูแลบัญชีหรือ Call Center ทันที"
          }
        }
      }
    },
    "info.help.lost": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lost or stolen card"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บัตรหายหรือถูกขโมย"
          }
        }
      }
    },
    "info.help.lost.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open the Cards tab, choose the card and tap \"Report lost\". The card is blocked at once and a replacement is issued."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไปที่แท็บบัตร เลือกบัตร แล้วกด \"แจ้งบัตรหาย\" ระบบจะปิดบัตรทันทีและออกบัตรใหม่ให้"
          }
        }
      }
    },
    "info.privacy": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Privacy (PDPA)"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ความเป็นส่วนตัว (PDPA)"
          }
        }
      }
    },
    "info.privacy.collect": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What we collect"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ข้อมูลที่เราเก็บ"
          }
        }
      }
    },
    "info.privacy.collect.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Identity, account and transaction data, and details of your bound device. Face ID data stays on your phone and never reaches the bank."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ข้อมูลระบุตัวตน ข้อมูลบัญชีและธุรกรรม และข้อมูลอุปกรณ์ที่ผูกไว้ ข้อมูลใบหน้าอยู่ในเครื่องของคุณเท่านั้น ธนาคารไม่ได้รับ"
          }
        }
      }
    },
    "info.privacy.rights": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your rights"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สิทธิของคุณ"
          }
        }
      }
    },
    "info.privacy.rights.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can ask to access, correct, delete or object to the use of your data under the Personal Data Protection Act 2019, through your relationship manager."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ขอเข้าถึง แก้ไข ลบ หรือคัดค้านการใช้ข้อมูลได้ตาม พ.ร.บ.คุ้มครองข้อมูลส่วนบุคคล พ.ศ. 2562 ผ่านผู้ดูแลบัญชี"
          }
        }
      }
    },
    "info.privacy.use": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How we use it"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เราใช้ข้อมูลอย่างไร"
          }
        }
      }
    },
    "info.privacy.use.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To provide the service, prevent fraud and meet legal duties. Marketing is sent only if you turn it on in Settings."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพื่อให้บริการ ป้องกันการทุจริต และปฏิบัติตามกฎหมาย ข่าวสารการตลาดส่งเฉพาะเมื่อคุณเปิดรับในการตั้งค่า"
          }
        }
      }
    },
    "info.simulation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This app is a simulation. This text is an example only and is not a real legal document."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แอปนี้เป็นระบบจำลอง เนื้อหานี้เป็นตัวอย่างเท่านั้น ไม่ใช่ข้อกำหนดทางกฎหมายจริง"
          }
        }
      }
    },
    "info.terms": {
      "extractionState": "manual",
      "localizations": {
